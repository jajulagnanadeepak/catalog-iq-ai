# CatalogIQ AI backend configuration. Copy to backend/.env and fill in.
# Never commit the real .env file.

# MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Must match your existing database name EXACTLY (names are case-sensitive).
# The code default is "CatalogIQ". Check /health/ready: if catalog_products is 0,
# this is probably wrong.
DATABASE_NAME=CatalogIQ

# JWT - required outside development. At least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# App
# development | test | staging | production
# Outside development/test, the API refuses to start with a placeholder or short
# JWT_SECRET, or with ALLOWED_ORIGINS set to "*".
APP_ENV=development
# Comma-separated list of allowed browser origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Search reranker: v1 (default, baseline) | v2 (catalogue category vocabulary +
# diversity backfill; see eval/BASELINE.md S1/S2). Compare with backend/eval.
# SEARCH_RERANK_VERSION=v1
# v2 only: soft downranking of children's products for non-kids queries (S4).
# SEARCH_V2_KIDS_DOWNRANK=false
# v2 only: +0.25 for explicitly requested patterns, navy -> dark blue (S3-lite).
# SEARCH_V2_ATTRIBUTE_BOOST=false
